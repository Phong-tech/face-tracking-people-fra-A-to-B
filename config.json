{
  "camera_index": 0,
  "frame_width": 1280,
  "frame_height": 720,
  "show_window": true,

  "model_path": "yolo11n.pt",
  "tracker": "bytetrack.yaml",
  "detection_confidence": 0.4,
  "inference_image_size": 640,
  "device": "auto",

  "line_orientation": "horizontal",
  "line_position": 0.5,
  "entry_direction": "down",
  "dead_zone_fraction": 0.05,
  "reference_point_ratio": 0.85,
  "tracking_timeout_seconds": 3.0,
  "line_step": 0.02,

  "serial_enabled": true,
  "serial_port": "auto",
  "baud_rate": 9600,
  "serial_settle_seconds": 2.0,
  "heartbeat_interval_seconds": 2.0,
  "reconnect_interval_seconds": 5.0,

  "low_occupancy_threshold": 5,
  "medium_occupancy_threshold": 10,
  "max_capacity": 15,

  "log_interval_seconds": 60,
  "data_dir": "data"
}
